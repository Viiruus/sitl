{
  "name": "sitl",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "db:sanitize-inline-images": "tsx prisma/scripts/sanitize-inline-images.ts",
    "postinstall": "nuxt prepare && prisma generate",
    "vercel-build": "node --input-type=module -e \"import { execSync } from 'node:child_process'; console.log('VERCEL_ENV=', process.env.VERCEL_ENV); execSync('npx prisma migrate deploy', { stdio: 'inherit' }); if (process.env.VERCEL_ENV === 'preview') { console.log('Preview -> seeding'); execSync('npx prisma db seed', { stdio: 'inherit' }); } else { console.log('Not preview -> skip seed'); }\" && nuxt build"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@libsql/client": "^0.15.15",
    "@prisma/adapter-better-sqlite3": "^7.0.1",
    "@prisma/adapter-libsql": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@vue-hero-icons/outline": "^1.7.2",
    "@vuepic/vue-datepicker": "^12.1.0",
    "better-sqlite3": "^12.5.0",
    "heroicons": "^2.2.0",
    "nuxt": "^4.1.3",
    "nuxt-auth-utils": "^0.5.25",
    "nuxt-headlessui": "^1.2.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nuxt/image": "^1.8.0",
    "@nuxtjs/seo": "^3.4.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^24.10.1",
    "baseline-browser-mapping": "^2.9.11",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0"
  }
}
