// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  // Use SQLite provider; runtime connections go through the libsql adapter in code.
  provider = "sqlite"
  // Prisma 7: l'URL est dans prisma.config.ts via DATABASE_URL / TURSO_DATABASE_URL
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIMBER
  GUIDE
  ADMIN
}

enum AventureFormule {
  GRIMPE_SEULEMENT
  IMMERSION_COMPLETE
}

enum AventureDiscipline {
  FALAISE
  GRANDE_VOIE
  BLOC
  TRAD
  VIA_FERRATA
}

enum AventureSessionStatut {
  BROUILLON
  OUVERT
  COMPLET
  ANNULE
}

enum BookingStatut {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

enum ImageKind {
  COVER
  GALLERY
}

enum WhatsAppOtpPurpose {
  GUIDE_LOGIN
  CLIMBER_LOGIN
}

enum WhatsAppOtpStatus {
  PENDING
  CONSUMED
  EXPIRED
  MAX_ATTEMPTS
  INVALIDATED
  SEND_FAILED
}

enum GuideGender {
  male
  female
}

enum StageNotificationSubscriptionKind {
  STAGE_LISTING
  GUIDE_STAGE
}

enum StageNotificationDeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id Int @id @default(autoincrement())

  // Auth de base
  email        String  @unique
  passwordHash String?
  googleId     String? @unique
  facebookId   String? @unique

  role    UserRole @default(CLIMBER)
  // Permission transverse : un moniteur reste GUIDE tout en pouvant administrer la plateforme.
  isAdmin Boolean  @default(false)

  acquisitionSource String? // "direct", "landing", "google", "facebook", etc.

  // Informations personnelles
  firstName       String?
  lastName        String?
  birthDate       String?
  department      String? // ex: "38 - Isère"
  phoneNumber     String?
  whatsappOptIn   Boolean @default(false)
  profileImageUrl String?

  // Pratique de l’escalade
  /// typesOfClimbing: JSON pour stocker un tableau de strings
  /// ex: ["bloc", "sport", "multi", "trad", "via_ferrata"]
  typesOfClimbing Json?

  /// climbsMainly: "lead", "toprope" ou null
  climbsMainly String?

  /// environments: JSON, ex: ["exterieur","salle_privee","salle_asso"]
  environments Json?

  /// autonomy: JSON, ex: ["assur_moulinette","assur_tete","manip_haut_de_voie","rechappe"]
  autonomy Json?

  /// frequency: "moins_1", "1", "2_3", "plus_3"
  frequency String?

  // Niveau
  /// gradeLevel: "sub_5a", "5a_5c", "6a_6c", "7_plus", "dont_know"
  gradeLevel String?

  /// preferredClimbingStyle: "devers", "vertical", "dalle"
  preferredClimbingStyle String?

  /// climbingGoal: texte libre
  climbingGoal String?

  /// boulderingLocations: JSON, ex: ["salle","exterieur"]
  boulderingLocations Json?

  /// boulderingGrade: "jaune", "vert", "bleu", "rouge", "noir", "violet"
  boulderingGrade String?

  /// belayDevices: JSON, ex: ["reverso","grigri","smart_jul"]
  belayDevices Json?

  /// multiAutonomy: JSON, ex: ["assur_haut_voie","rappel","leader_cordee"]
  multiAutonomy Json?

  /// tradProtections: JSON, ex: ["friends","cables","piton","lunule"]
  tradProtections Json?

  /// tradMovingBelay: "oui", "non"
  tradMovingBelay String?

  // Vision du voyage / stage
  /// tripStyles: JSON, ex: ["aventure","confort"]
  tripStyles Json?

  // Onboarding
  onboarded      Boolean @default(false)
  onboardingStep Int     @default(0)

  // 👇 pour les moniteurs (facultatif)
  guideProfile GuideProfile?
  aventures    Aventure[]    @relation("GuideAventures")
  articles     Article[]     @relation("GuideArticles")

  // 👇 pour les grimpeurs qui réservent
  bookings                            Booking[]
  dateSuggestions                     AventureDateSuggestion[]
  associationMemberships              AssociationMembership[]
  whatsappOtpChallenges               WhatsAppOtpChallenge[]
  guideContactRequestsSent            GuideContactRequest[]           @relation("GuideContactRequestsSent")
  guideContactRequestsReceived        GuideContactRequest[]           @relation("GuideContactRequestsReceived")
  stageNotificationSubscriptions      StageNotificationSubscription[] @relation("StageNotificationSubscriptions")
  guideStageNotificationSubscriptions StageNotificationSubscription[] @relation("GuideStageNotificationSubscriptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WhatsAppOtpChallenge {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  purpose     WhatsAppOtpPurpose
  status      WhatsAppOtpStatus  @default(PENDING)
  publicToken String             @unique

  phoneNumber String
  source      String?

  codeHash    String
  attempts    Int    @default(0)
  maxAttempts Int    @default(5)

  templateName  String?
  messageId     String? @unique
  messageStatus String?
  failureReason String?

  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  lastAttemptAt DateTime?
  sentAt        DateTime?

  lastWebhookPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose, phoneNumber, status])
  @@index([expiresAt])
}

model AssociationMembership {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  membershipYear Int
  amountCents    Int
  currency       String   @default("EUR")
  roleSnapshot   UserRole
  source         String?
  acceptedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, membershipYear])
  @@index([membershipYear])
}

model GuideProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  bio                     String?
  gender                  GuideGender?
  baseLocation            String? // "Massif des Bauges"
  serviceAreas            Json?
  instagramUrl            String?
  googleBusinessUrl       String?
  googlePlaceId           String?
  professionalCardNumber  String?
  stageTermsAndConditions String?

  // ✅ Nouveau : image principale du moniteur
  profileImageUrl      String?
  profileImageVariants Json?

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id   Int    @id @default(autoincrement())
  slug String @unique

  title              String
  coverImageUrl      String
  coverImageVariants Json?
  content            Json

  authorId Int
  author   User @relation("GuideArticles", fields: [authorId], references: [id], onDelete: Cascade)

  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId, createdAt])
  @@index([isPublished, publishedAt])
}

model GuideContactRequest {
  id Int @id @default(autoincrement())

  guideId Int
  guide   User @relation("GuideContactRequestsReceived", fields: [guideId], references: [id], onDelete: Cascade)

  climberId Int
  climber   User @relation("GuideContactRequestsSent", fields: [climberId], references: [id], onDelete: Cascade)

  message        String
  messagePreview String

  climberNameSnapshot  String?
  climberPhoneSnapshot String
  guidePhoneSnapshot   String

  templateName  String?
  messageId     String? @unique
  messageStatus String?
  failureReason String?

  sentAt DateTime?

  lastWebhookPayload Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guideId, createdAt])
  @@index([climberId, createdAt])
}

model Aventure {
  id   Int    @id @default(autoincrement())
  slug String @unique

  titre      String
  sousTitre  String?
  discipline AventureDiscipline
  formule    AventureFormule    @default(GRIMPE_SEULEMENT)

  // ✅ si tu veux pouvoir dire "petites + grandes voies"
  disciplinesComplementaires Json?

  lieuLabel String // "Presles, Vercors"
  pays      String? @default("France")
  region    String?

  jours         Float
  placesMax     Int
  placesMin     Int     @default(0)
  niveauMinimum String? // "5b", "6a", etc.
  autonomieMini String? // "assur_tete", etc.

  prixParPersonne Int
  devise          String @default("EUR")

  inclus       String? // "Encadrement + hébergement + repas"
  nonInclus    String? // "Transport, matériel perso"
  pointsLocaux String? // "Ferme X, fromagerie Y..."

  // ✅ Nouvelles infos “fiche voyage”
  descriptionCourte String?
  descriptionLongue String?
  objectifs         String?

  prerequis        Json?
  equipementRequis Json?
  equipementFourni Json?

  hebergementLabel   String?
  hebergementDetails String?
  repasLabel         String?
  transportLabel     String?
  pointRdv           String?
  latitude           Float?
  longitude          Float?
  langues            Json?

  ageMin Int?
  ageMax Int?

  // ✅ Images
  coverImageUrl               String?
  coverImageVariants          Json?
  images                      AventureImage[]
  dateSuggestions             AventureDateSuggestion[]
  stageNotificationDeliveries StageNotificationDelivery[]

  // ✅ Programme structuré
  programmeJours AventureJour[]

  guideId Int
  guide   User @relation("GuideAventures", fields: [guideId], references: [id])

  sessions AventureSession[]

  estPublie Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StageNotificationSubscription {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation("StageNotificationSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  kind StageNotificationSubscriptionKind @default(STAGE_LISTING)

  discipline AventureDiscipline?
  region     String?
  dateStart  DateTime?
  dateEnd    DateTime?

  guideId Int?
  guide   User? @relation("GuideStageNotificationSubscriptions", fields: [guideId], references: [id], onDelete: Cascade)

  active         Boolean   @default(true)
  lastNotifiedAt DateTime?

  deliveries StageNotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, active])
  @@index([userId, active])
  @@index([guideId, active])
}

model StageNotificationDelivery {
  id Int @id @default(autoincrement())

  subscriptionId Int
  subscription   StageNotificationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  aventureId Int
  aventure   Aventure @relation(fields: [aventureId], references: [id], onDelete: Cascade)

  sessionId Int?
  session   AventureSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  deliveryKey String @unique

  status        StageNotificationDeliveryStatus
  templateName  String
  messageId     String?                         @unique
  failureReason String?
  sentAt        DateTime?
  lastPayload   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aventureId])
  @@index([sessionId])
}

model AventureImage {
  id         Int      @id @default(autoincrement())
  aventureId Int
  aventure   Aventure @relation(fields: [aventureId], references: [id], onDelete: Cascade)

  url      String
  kind     ImageKind @default(GALLERY)
  alt      String?
  position Int?
  variants Json?

  createdAt DateTime @default(now())

  @@index([aventureId])
}

model AventureSession {
  id         Int      @id @default(autoincrement())
  aventureId Int
  aventure   Aventure @relation(fields: [aventureId], references: [id])

  dateDebut DateTime
  dateFin   DateTime

  statut          AventureSessionStatut @default(OUVERT)
  placesTotales   Int
  placesReservees Int                   @default(0)

  prixSpecifique Int?

  reservations                Booking[]
  stageNotificationDeliveries StageNotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AventureDateSuggestion {
  id         Int      @id @default(autoincrement())
  aventureId Int
  aventure   Aventure @relation(fields: [aventureId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime?
  comment   String?

  createdAt DateTime @default(now())

  @@index([aventureId])
  @@index([userId])
}

model AventureJour {
  id         Int      @id @default(autoincrement())
  aventureId Int
  aventure   Aventure @relation(fields: [aventureId], references: [id], onDelete: Cascade)

  ordre       Int
  titre       String
  description String?
  lieuLabel   String?
  discipline  AventureDiscipline?

  @@unique([aventureId, ordre])
  @@index([aventureId])
}

model Booking {
  id        Int             @id @default(autoincrement())
  sessionId Int
  session   AventureSession @relation(fields: [sessionId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id])

  statut       BookingStatut @default(EN_ATTENTE)
  participants Int           @default(1)
  montant      Int // montant total en €

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
